# Copy to .env.local for local development. Never commit a file with real values.

# Neon Postgres connection string. Without it, submissions are written to
# data/submissions/ in development, and are NOT stored at all in production.
DATABASE_URL=

# Admin login for /admin. Must be at least 12 characters.
# This single password is the only thing protecting respondent data — treat it accordingly.
ADMIN_PASSWORD=

# Signing key for the admin session cookie. At least 32 bytes of randomness.
# Rotating this immediately invalidates every existing session, which is how you revoke access.
# Generate one with:  openssl rand -base64 48
ADMIN_SESSION_SECRET=
